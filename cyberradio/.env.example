# ===== LLM (可选, 暂不强制) =====
# ANTHROPIC_API_KEY=

# ===== TTS - MiniMax =====
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# 可选: 默认音色 ID, 留空使用 MiniMax 默认
MINIMAX_VOICE_ID=
# T2A 模型, 默认 speech-02-hd
MINIMAX_MODEL=speech-02-hd

# ===== Tavily 网搜 =====
TAVILY_API_KEY=

# ===== 飞书 (仅日历) =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书账号邮箱, 用来定位主日历
FEISHU_USER_EMAIL=

# ===== 天气 (和风天气, 免费版即可) =====
QWEATHER_KEY=
# 默认城市 (LocationID 或 经纬度 'lon,lat')
QWEATHER_LOCATION=

# ===== PWA / HTTP 服务端口 =====
PWA_PORT=5050
# 设为 0 时仅运行 stdio MCP，不启动播放器桥接
CYBERRADIO_BRIDGE=1

# ===== 网易云 cookie (扫码登录后由 scripts/ncm-login.js 写入, 也可手动填) =====
NCM_COOKIE=
